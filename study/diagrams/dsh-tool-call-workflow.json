      "col": 4,
      "type": "messagebus",
      "label": "异常归一化",
      "sublabel": "超时 / 抛错 / 沙箱拒绝",
      "tag": "回合不中断",
      "width": 140,
      "height": 72
    },
    {
      "id": "log_call",
      "lane": "observe",
      "col": 0,
      "type": "database",
      "label": "记录 tool/call",
      "sublabel": "执行前追加会话日志",
      "width": 140,
      "height": 72
    },
    {
      "id": "audit",
      "lane": "observe",
      "col": 2,
      "type": "database",
      "label": "审批审计",
      "sublabel": "approval/asked → decided",
      "width": 140,
      "height": 72
    },
    {
      "id": "log_result",
      "lane": "observe",
      "col": 5,
      "type": "database",
      "label": "记录 tool/result",
      "sublabel": "isError 记 error",
      "width": 140,
      "height": 72,
      "yOffset": -46
    },
    {
      "id": "telemetry",
      "lane": "observe",
      "col": 5,
      "type": "messagebus",
      "label": "遥测 emit",
      "sublabel": "脱敏瀑布后交给 otel",
      "width": 140,
      "height": 72,
      "yOffset": 46
    }
  ],
  "edges": [
    {
      "id": "call-pre",
      "from": "tool_call",
      "to": "pre_execute",
      "label": "进入瀑布",
      "variant": "emphasis",
      "role": "main",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "pre-approval",
      "from": "pre_execute",
      "to": "approval",
      "label": "ask",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "approval-execute",
      "from": "approval",
      "to": "execute",
      "label": "allowed-once",
      "variant": "emphasis",
      "role": "main",
      "fromSide": "right",
      "toSide": "top"
    },
    {
      "id": "execute-post",
      "from": "execute",
      "to": "post_execute",
      "label": "无损结果快照",
      "variant": "emphasis",
      "role": "main",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "post-result",
      "from": "post_execute",
      "to": "tool_result",
      "label": "finalizeContent",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "call-card",
      "from": "tool_call",
      "to": "card_pending",
      "label": "presentCall",
      "role": "branch",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "call-log",
      "from": "tool_call",
      "to": "log_call",
      "label": "先记录再执行",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "approval-prompt",
      "from": "approval",
      "to": "approval_prompt",
      "label": "一次性询问 · allow / reject",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "pre-denied",
      "from": "pre_execute",
      "to": "denied",
      "label": "deny（hook / never 策略）",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "approval-denied",
      "from": "approval",
      "to": "denied",
      "label": "rejected / unavailable",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "denied-normalize",
      "from": "denied",
      "to": "normalize",
      "label": "Error 结果",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "execute-normalize",
      "from": "execute",
      "to": "normalize",
      "label": "超时 / 抛错 / [sandbox: denied]",
      "variant": "security",
      "role": "error",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "normalize-post",
      "from": "normalize",
      "to": "post_execute",
      "label": "isError 结果继续结算",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "result-card",
      "from": "tool_result",
      "to": "card_done",
      "label": "presentResult",
      "role": "branch"
    },
    {
      "id": "log-audit",
      "from": "log_call",
      "to": "audit",
      "label": "approval/asked · decided",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "audit-log",
      "from": "audit",
      "to": "log_result",
      "label": "tool/result → 遥测",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "result-next",
      "from": "tool_result",
      "to": "next_step",
      "label": "读取结果后决定",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "log-telemetry",
      "from": "log_result",
      "to": "telemetry",
      "label": "sessionTelemetry/record",
      "variant": "dashed",
      "role": "async"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "审批语义",
      "items": [
        "ctx.approval.request() 只返回 allowed-once / rejected / cancelled / unavailable，没有 allow-always",
        "答复者缺席、抛错或返回非法值一律 unavailable，失败关闭；never 策略在任何答复者之前确定性拒绝",
        "请求必须在打开的 turn 内；答复者只看到工具名与理由，看不到参数"
      ]
    },
    {
      "dot": "rose",
      "title": "重试与阻塞",
      "items": [
        "模型请求失败由 dsh-llm-retry 在 agent/request-error 上先写 llm/retry 事件再等待，同一 turn 内重跑同一步",
        "工具超时、抛错、沙箱拒绝都变成 isError 结果交回模型；沙箱拒绝可用 sandbox_permissions + justification 同 turn 重试一次，经审批提示取得同意",
        "PreToolUse hook 只能 deny / ask，PostToolUse 可用反馈阻断，单调守卫不可被后来的监听者绕过；相同调用 3 / 5 / 8 次触发提醒但不阻断"
      ]
    },
    {
      "dot": "emerald",
      "title": "证据路径",
      "items": [
        "tool/call 在执行前记录；tool/result 是唯一模型可见结果，UI 卡片与回放都由它派生",
        "approval/asked 与 approval/decided 仅入日志，不进模型上下文；工具自有事件 fs/observed、hook/invoked、tool/ptc-dispatch 同样落日志",
        "遥测复制每条事件，经 sessionTelemetry/record 脱敏瀑布交给 OTel 后端，isError 记为 error 级别",
        "新增 projectContent：工具体返回后、post-execute 之前，由定义方把执行期准备好的文本与图片投影进结果"
      ]
    }
  ]
}
