{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "DeepSeek Harness 工具调用流水线",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "dsh-tool-call-workflow.html"
  },
  "lanes": [
    {
      "id": "ui",
      "label": "用户界面"
    },
    {
      "id": "agent",
      "label": "Agent Runtime"
    },
    {
      "id": "policy",
      "label": "策略边界"
    },
    {
      "id": "tools",
      "label": "工具执行"
    },
    {
      "id": "exception",
      "label": "异常处理",
      "variant": "exception"
    },
    {
      "id": "observe",
      "label": "可观测性"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "登记调用",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "gate",
      "label": "策略门",
      "fromCol": 1,
      "toCol": 2,
      "variant": "security"
    },
    {
      "id": "run",
      "label": "执行",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "settle",
      "label": "结算",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "tool_call",
    "pre_execute",
    "approval",
    "execute",
    "post_execute",
    "tool_result"
  ],
  "nodes": [
    {
      "id": "card_pending",
      "lane": "ui",
      "col": 0,
      "type": "frontend",
      "label": "待处理卡片",
      "sublabel": "presentCall(args)",
      "width": 140,
      "height": 72
    },
    {
      "id": "approval_prompt",
      "lane": "ui",
      "col": 2,
      "type": "frontend",
      "label": "审批提示",
      "sublabel": "人工一次性回答",
      "tag": "人在环",
      "width": 140,
      "height": 72
    },
    {
      "id": "card_done",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "完成卡片",
      "sublabel": "presentResult(args, result)",
      "width": 140,
      "height": 72
    },
    {
      "id": "tool_call",
      "lane": "agent",
      "col": 0,
      "type": "backend",
      "label": "tool/call",
      "sublabel": "assistant 消息含工具调用",
      "tag": "先记录",
      "width": 140,
      "height": 72
    },
    {
      "id": "tool_result",
      "lane": "agent",
      "col": 5,
      "type": "backend",
      "label": "tool/result",
      "sublabel": "单一模型可见结果",
      "width": 140,
      "height": 72
    },
    {
      "id": "next_step",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "模型决定下一步",
      "sublabel": "重试 · 升级权限 · 换方法",
      "tag": "同一 turn 内",
      "width": 140,
      "height": 72
    },
    {
      "id": "pre_execute",
      "lane": "policy",
      "col": 1,
      "type": "security",
      "label": "tools/pre-execute",
      "sublabel": "PreToolUse hook · 权限预设",
      "tag": "allow / ask / deny",
      "width": 140,
      "height": 72
    },
    {
      "id": "approval",
      "lane": "policy",
      "col": 2,
      "type": "security",
      "label": "ctx.approval",
      "sublabel": "答复者瀑布，缺席即拒绝",
      "tag": "fail-closed",
      "width": 140,
      "height": 72
    },
    {
      "id": "post_execute",
      "lane": "policy",
      "col": 5,
      "type": "security",
      "label": "tools/post-execute",
      "sublabel": "投影 · 放行 · 阻断 · 补上下文",
      "width": 140,
      "height": 72
    },
    {
      "id": "execute",
      "lane": "tools",
      "col": 3,
      "type": "backend",
      "label": "execute() 工具体",
      "sublabel": "沙箱内 bash / fs / web",
      "tag": "exec.signal 可取消",
      "width": 140,
      "height": 72
    },
    {
      "id": "denied",
      "lane": "exception",
      "col": 2,
